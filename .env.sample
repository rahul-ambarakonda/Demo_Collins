# Application Settings
NODE_ENV="development" # The application environment (e.g., development, production, test)
PORT="3000"           # The port on which the Next.js frontend application will run

# Backend API Settings
API_PORT="3001"       # The port on which the NestJS backend API will run
API_URL="http://localhost:3001" # The base URL for the backend API, used by the backend itself (e.g., for Swagger, internal requests)
NEXT_PUBLIC_API_URL="http://localhost:3001" # The public base URL for the backend API, accessible by the frontend client

# Database Configuration (PostgreSQL)
DB_HOST="localhost"     # The hostname or IP address of the PostgreSQL database server
DB_PORT="5432"          # The port number for the PostgreSQL database connection
DB_USER="your_db_user"  # The username for connecting to the PostgreSQL database
DB_PASSWORD="your_db_password" # The password for connecting to the PostgreSQL database
DB_NAME="your_database_name"   # The name of the PostgreSQL database
DB_SYNCHRONIZE="true"   # (Development only) Whether to automatically synchronize the database schema
DB_LOGGING="true"       # (Development only) Whether to log SQL queries to the console

# Authentication & Security
JWT_SECRET="your_jwt_secret_here" # A strong, secret key used for signing JWTs
JWT_EXPIRATION_TIME="1h"          # The expiration time for JWTs (e.g., 1h, 24h, 7d)

# Logging
LOG_LEVEL="info" # The minimum level for logs to be displayed (e.g., error, warn, info, debug, verbose)
